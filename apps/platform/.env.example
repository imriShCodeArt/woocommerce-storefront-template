# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WooCommerce store. Leave unset to browse the built-in sample catalog.
# Cart, checkout, and customer accounts always stay on this host.
# Pretty permalinks ("Post name") are required so /cart/, /checkout/, and /my-account/ resolve.
# NEXT_PUBLIC_WOOCOMMERCE_STORE_URL=https://shop.example.com

# Optional REST API keys (WooCommerce → Settings → Advanced → REST API).
# Read permission is enough. When both are set, the catalog uses wc/v3, including variations.
# When both are empty, the public Store API (wc/store/v1) is used.
# WOOCOMMERCE_CONSUMER_KEY=ck_replace_me
# WOOCOMMERCE_CONSUMER_SECRET=cs_replace_me

# Optional Google Tag Manager container (for example GTM-XXXX).
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXXX

# Optional contact email via Resend.
# RESEND_API_KEY=
# CONTACT_FROM_EMAIL=Storefront <hello@example.com>
# CONTACT_TO_EMAIL=hello@example.com
